FROM docker.m.daocloud.io/golang:1.25-alpine AS builder
WORKDIR /app
# All dependencies are public (the plugin contract is inlined under
# internal/plugincontract), so modules are fetched from the Go proxy — no
# vendor tree, no git credentials, no private hosts. The mainland mirror keeps
# self-hosted/local builds reachable; `,direct` falls through when it is not.
ENV GOPROXY=https://goproxy.cn,direct
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/plugin-backfill ./cmd/plugin-backfill

FROM docker.m.daocloud.io/alpine:3.21
ENV TZ=Asia/Shanghai
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /bin/plugin-backfill /bin/plugin-backfill
ENTRYPOINT ["/bin/plugin-backfill"]
# Safe read-only default: report what a migration would do without writing.
# Override with e.g.: -phase=enrich -mode=apply / -phase=repackage -mode=verify
CMD ["-phase=repackage", "-mode=dry-run"]
