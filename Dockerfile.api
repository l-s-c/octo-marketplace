FROM docker.m.daocloud.io/golang:1.25-alpine AS builder
WORKDIR /app
# The private codex.mlamp.cn plugin lib is fetched over anonymous HTTPS at build
# time (GOPRIVATE skips the public proxy/sumdb; GIT_TERMINAL_PROMPT=0 makes git
# fail fast instead of prompting for credentials). git is needed for the fetch.
RUN apk add --no-cache git
ENV GOPRIVATE=codex.mlamp.cn GIT_TERMINAL_PROMPT=0
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/marketplace-api ./cmd/marketplace-api

FROM docker.m.daocloud.io/alpine:3.21
ENV TZ=Asia/Shanghai
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /bin/marketplace-api /bin/marketplace-api
EXPOSE 8092
ENTRYPOINT ["/bin/marketplace-api"]
